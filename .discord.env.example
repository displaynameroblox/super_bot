# Create .discord.env with mode 600 before putting credentials in it.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
# Empty enables DMs only. Enter comma-separated text channel IDs for the alpha.
DISCORD_CHANNEL_IDS=
DISCORD_MENTION_ONLY=1
DISCORD_DAILY_REQUESTS=60
DISCORD_USER_COOLDOWN=10
DISCORD_PROVIDER_TIMEOUT=45
# Set to openai, gemini, openrouter, groq or local for unattended startup.
DISCORD_PROVIDER=

# Configure the selected provider only. Existing Super-Bot provider values can be reused.
# OPENAI_API_KEY=
# OPENAI_MODEL_NAME=
# GEMINI_API_KEY=
# GEMINI_MODEL_NAME=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_NAME=
# GROQ_API_KEY=
# GROQ_MODEL_NAME=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=45
# GROQ_MAX_COMPLETION_TOKENS=2048
# PHONE_MODEL_FALLBACK_PROVIDER=openrouter
# For an already running local endpoint. Managed local models use --managed-root.
# PHONE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# PHONE_MODEL_NAME=superbot-phone
# TEST_PHONE_API_KEY=

# Optional node mode. Configure the same private token on the node.
# SUPER_BOT_DISCORD_NODE_URL=https://127.0.0.1:8000
# SUPER_BOT_DISCORD_NODE_TOKEN=
