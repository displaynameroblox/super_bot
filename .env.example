# Copy to .env and fill in real values.
GEMINI_API_KEY=your-gemini-api-key-here
# PHONE_MODEL_BASE_URL=https://phone-address:8080
# TEST_PHONE_API_KEY=your-phone-model-key-here

# Super Bot listens on this computer only by default.
# HOST=127.0.0.1
# SUPER_BOT_ALLOW_LAN=1          # required to listen on a non-loopback HOST
# SUPER_BOT_ALLOW_REGISTRATION=1 # temporary server login registration
# Server login/session data is RAM-only. Saved accounts, chats, and knowledge
# are stored by clients next to known_servers.json in client-data/.

# Optional OpenAI cloud provider (server only):
# PHONE_MODEL_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL_NAME=your-openai-model-id
# PHONE_MODEL_TIMEOUT_SECONDS=600

# Miso node integration. See docs/miso-3.1.0a1.md.
# SUPER_BOT_DISCORD_NODE_TOKEN=
# DISCORD_OWNER_ID=
# DISCORD_CHANNEL_IDS=
# SUPER_BOT_DISCORD_DATA_DIR=
# SUPER_BOT_ROBLOX_BRIDGE=0

# Optional GroqCloud provider (server only). Keep the actual key in private .env.
# PHONE_MODEL_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL_NAME=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=45
# GROQ_MAX_COMPLETION_TOKENS=2048
# Optional failover after HTTP 429 or 503. Configure both providers' keys and models.
# PHONE_MODEL_FALLBACK_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_NAME=
