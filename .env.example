# Copy to .env and fill in real values.
GEMINI_API_KEY=your-gemini-api-key-here
# PHONE_MODEL_BASE_URL=https://phone-address:8080
# TEST_PHONE_API_KEY=your-phone-model-key-here

# Super Bot listens on this computer only by default.
# HOST=127.0.0.1
# SUPER_BOT_ALLOW_LAN=1          # required to listen on a non-loopback HOST
# SUPER_BOT_ALLOW_REGISTRATION=1 # temporary server login registration
# Server login/session data is RAM-only. Saved accounts, chats, and knowledge
# are stored by clients next to known_servers.json in client-data/.

# Optional OpenAI cloud provider (server only):
# PHONE_MODEL_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL_NAME=your-openai-model-id
# PHONE_MODEL_TIMEOUT_SECONDS=600
