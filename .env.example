# Copy to .env and fill in real values. Never commit .env or share it.
GEMINI_API_KEY=your-gemini-api-key-here
# PHONE_MODEL_BASE_URL=https://phone-address:8080
# PHONE_MODEL_API_KEY=your-phone-model-key-here

# Super Bot listens on this computer only by default.
# HOST=127.0.0.1
# SUPER_BOT_ALLOW_LAN=1          # required to listen on a non-loopback HOST
# SUPER_BOT_ALLOW_REGISTRATION=1 # 0 = only the first account can register
# SUPER_BOT_DB=                  # override the database location
